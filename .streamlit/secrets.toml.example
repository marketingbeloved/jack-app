# Скопируй в .streamlit/secrets.toml и впиши значения (их даёт Дарья).
# secrets.toml в git НЕ коммитим — репозиторий публичный.

APP_PASSWORD = "..."            # пароль входа в приложение

SUPABASE_URL = "https://....supabase.co"   # общая база: КП, ТЗ, концепты, правила Джека
SUPABASE_KEY = "sb_secret_..."

GEMINI_API_KEY = "..."          # мозг на сайте + «зрение» (подписи к рилсам). Лучше постоянный AIzaSy…

NOTION_TOKEN = "ntn_..."        # ТЗ Дине в базу Videos

# Необязательные (если пусто — соответствующая кнопка просто не работает):
# ANTHROPIC_API_KEY = "sk-ant-..."   # не используем, карты нет; локально мозг = claude CLI
# CLICKUP_TOKEN = "..."  CLICKUP_LIST_ID = "..."  CLICKUP_VIEW = "..."
# VIKA_SHEET_ID = "..."  [gcp_service_account]  # таблица Вики
